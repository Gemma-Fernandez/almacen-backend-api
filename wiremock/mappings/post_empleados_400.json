{
  "request":
  { "method": "POST",
    "url": "/api/v1/empleados",
    "bodyPatterns":
    [ { "matchesJsonPath": "$[?(@.salario < 0)]" } ]
  },
  "response":
  { "status": 400,
    "headers":
    { "Content-Type": "application/json" },
    "jsonBody":
    { "timestamp": "2026-11-17",
      "status": 400,
      "error": "Bad Request",
      "mensaje": "El salario del empleado no puede ser negativo."
    }
  } }
