{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-1234567890ab",
    "name": "Almacen API - Coleccion de Pruebas",
    "description": "Coleccion parametrizada para ejecutar en Postman Runner sobre la API Mock WireMock",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Productos",
      "item": [
        {
          "name": "GET Listar Productos con Filtros (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('La respuesta es un array de productos', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?codigoSKU=PROD-12345&stockMin=100&precioMax=100.00",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "codigoSKU",
                  "value": "PROD-12345"
                },
                {
                  "key": "stockMin",
                  "value": "100"
                },
                {
                  "key": "precioMax",
                  "value": "100.00"
                }
              ]
            }
          }
        },
        {
          "name": "POST Crear Producto Exito (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoSKU\": \"PROD-99999\",\n  \"nombre\": \"Mancuerna Maniak 15kg\",\n  \"precio\": 19.99,\n  \"stock\": 200,\n  \"fechaAlta\": \"2026-11-11\",\n  \"ubicacionId\": 3,\n  \"proveedorId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "GET Producto No Encontrado (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "999"
              ]
            }
          }
        },
        {
          "name": "GET Simular Error Servidor (500 Internal Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 500 Internal Server Error', function () {",
                  "    pm.response.to.have.status(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/error-simulado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "error-simulado"
              ]
            }
          }
        }
      ]
    }
  ]
}